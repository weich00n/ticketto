# Copy this file to .env.local in this folder (frontend/) and fill in the values.
# Next.js reads it only on startup, so restart `npm run dev` after any change.
#
# Values come from AWS Console → Cognito → User pools → Ticketto pool.
# Switch the console region to US East (N. Virginia) first, or the pool will not be listed.
AWS_REGION=us-east-1
# Pool overview → User pool ID. Starts with the region, e.g. us-east-1_AbC123xyz.
COGNITO_USER_POOL_ID=us-east-1_example
# App integration → App clients → Client ID. The client must allow
# ALLOW_USER_PASSWORD_AUTH and ALLOW_REFRESH_TOKEN_AUTH, and read the `name` attribute.
COGNITO_CLIENT_ID=example_client_id
# Same app client → Show client secret. Required when the client has a secret
# (the team's client does). Paste without quotes and never commit it.
COGNITO_CLIENT_SECRET=
# Only for the local emulator (http://localhost:9229). Leave empty for AWS.
COGNITO_ENDPOINT=
# API Gateway invoke URL without a trailing slash, e.g. https://abc123.execute-api.us-east-1.amazonaws.com/prod.
# Leave empty until the gateway is deployed; sign-in works without it.
API_GATEWAY_URL=
# Event screens use the sample data until this is "false" and API_GATEWAY_URL is set.
# Read at request time, so it can change without a rebuild.
USE_DEMO_DATA=
# Stripe → Developers → API keys → Publishable key (pk_test_… for the test account
# Checkout's STRIPE_API_KEY belongs to). Empty shows checkout without card payment.
STRIPE_PUBLISHABLE_KEY=
