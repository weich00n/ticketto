# Read by `docker compose` from this folder. Every other setting is a local-only value in
# docker-compose.yml, so the stack runs with this file as it is.
#
# Stripe test mode (optional). Without these, everything works except paying for an order.
#   STRIPE_API_KEY          Stripe Dashboard > Developers > API keys > Secret key (sk_test_...)
#   STRIPE_PUBLISHABLE_KEY  the matching Publishable key (pk_test_...)
#   STRIPE_WEBHOOK_SECRET   printed by `stripe listen` (full command in README.md)
# Use test-mode keys only, and don't commit real values.
STRIPE_API_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET= 

# Host ports. Change one if something else on your machine already uses it.
FRONTEND_PORT=3000
GATEWAY_PORT=8080
MAILPIT_UI_PORT=8025
RABBITMQ_UI_PORT=15672
COGNITO_PORT=9229
