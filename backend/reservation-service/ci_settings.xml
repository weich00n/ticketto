<?xml version="1.0" encoding="UTF-8"?>
<!-- Maven settings for the contract-tests CI job: reads rabbitmq-service's package registry
     (ticketto-contracts) with this job's CI_JOB_TOKEN. rabbitmq-service must allow this project
     in its CI/CD job token settings if the registry is private. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <servers>
    <server>
      <id>ticketto-contracts</id>
      <configuration>
        <httpHeaders>
          <property>
            <name>Job-Token</name>
            <value>${env.CI_JOB_TOKEN}</value>
          </property>
        </httpHeaders>
      </configuration>
    </server>
  </servers>
</settings>
