# Copy to .env for local development. Never commit .env.
# docker-compose overrides DB_HOST, DB_PORT and COGNITO_ENDPOINT for the container.

AWS_REGION=us-east-1
# cognito-local does not check credentials, but boto3 needs some values.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Printed by scripts/seed-cognito-local.sh
COGNITO_ENDPOINT=http://localhost:9229
COGNITO_USER_POOL_ID=replace-with-local-pool-id

# Values used when running the service directly on your machine (not in Compose).
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=db_user
DB_USER=user_service
DB_PASSWORD=user_service_dev
# Root password for the local MySQL container only.
MYSQL_ROOT_PASSWORD=root_dev

LOG_LEVEL=INFO
