# For running on your machine; Compose sets these itself.
DATABASE_URL=mysql+pymysql://ticketto:ticketto@localhost:3311/ticket_service
# Ticket's own broker user (local password; the team broker has no guest user).
RABBITMQ_URL=amqp://ticket-service:ticketto-local@localhost:5672/%2F
PORT=3006
LOG_LEVEL=INFO
# none (default): no authentication yet, buyers send X-User-Id.
# gateway: trust API Gateway's Cognito headers (X-User-Sub, X-User-Groups) and require staff for check-in.
AUTH_MODE=none

# QR signing: key_id:secret pairs (secrets at least 32 characters). New tickets use
# QR_ACTIVE_KEY_ID; keep old keys listed after rotating so issued tickets still verify.
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
QR_SIGNING_KEYS=local:replace-with-a-long-random-secret-for-local-use
QR_ACTIVE_KEY_ID=local

# TicketIssued (notification-service sends the ticket email from it). The worker publishes
# pending messages every OUTBOX_POLL_SECONDS and retries a refused publish with backoff,
# doubling from OUTBOX_RETRY_BASE_SECONDS up to OUTBOX_RETRY_MAX_SECONDS, without giving up.
# OUTBOX_POLL_SECONDS=1
# OUTBOX_RETRY_BASE_SECONDS=5
# OUTBOX_RETRY_MAX_SECONDS=300

# Event Service's private address; used to fill in event details missing from messages.
# EVENT_SERVICE_URL=http://localhost:3001

# Used instead of DATABASE_URL in AWS. Never put real values here.
# DB_HOST=
# DB_PORT=3306
# DB_NAME=db_ticket
# DB_USER=
# DB_PASSWORD=
# DB_SSL_CA=/etc/ssl/rds/global-bundle.pem
