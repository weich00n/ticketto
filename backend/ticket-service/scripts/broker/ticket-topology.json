{
  "exchanges": [
    {
      "name": "checkout.events",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "event.events",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "ticket.events",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "ticketto.dlx",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "ticketto.unrouted",
      "vhost": "/",
      "type": "fanout",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "ticket-service.EventCancelled",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-dead-letter-exchange": "ticketto.dlx",
        "x-dead-letter-routing-key": "ticket-service.EventCancelled",
        "x-dead-letter-strategy": "at-least-once",
        "x-overflow": "reject-publish"
      }
    },
    {
      "name": "ticket-service.EventCancelled.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    },
    {
      "name": "ticket-service.EventPublished",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-dead-letter-exchange": "ticketto.dlx",
        "x-dead-letter-routing-key": "ticket-service.EventPublished",
        "x-dead-letter-strategy": "at-least-once",
        "x-overflow": "reject-publish"
      }
    },
    {
      "name": "ticket-service.EventPublished.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    },
    {
      "name": "ticket-service.OrderConfirmed",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-dead-letter-exchange": "ticketto.dlx",
        "x-dead-letter-routing-key": "ticket-service.OrderConfirmed",
        "x-dead-letter-strategy": "at-least-once",
        "x-overflow": "reject-publish"
      }
    },
    {
      "name": "ticket-service.OrderConfirmed.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    },
    {
      "name": "ticket-service.RefundCompleted",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-dead-letter-exchange": "ticketto.dlx",
        "x-dead-letter-routing-key": "ticket-service.RefundCompleted",
        "x-dead-letter-strategy": "at-least-once",
        "x-overflow": "reject-publish"
      }
    },
    {
      "name": "ticket-service.RefundCompleted.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    },
    {
      "name": "ticketto.unrouted",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    }
  ],
  "bindings": [
    {
      "source": "checkout.events",
      "vhost": "/",
      "destination": "ticket-service.OrderConfirmed",
      "destination_type": "queue",
      "routing_key": "order.confirmed",
      "arguments": {}
    },
    {
      "source": "checkout.events",
      "vhost": "/",
      "destination": "ticket-service.RefundCompleted",
      "destination_type": "queue",
      "routing_key": "refund.completed",
      "arguments": {}
    },
    {
      "source": "event.events",
      "vhost": "/",
      "destination": "ticket-service.EventCancelled",
      "destination_type": "queue",
      "routing_key": "event.cancelled",
      "arguments": {}
    },
    {
      "source": "event.events",
      "vhost": "/",
      "destination": "ticket-service.EventPublished",
      "destination_type": "queue",
      "routing_key": "event.published",
      "arguments": {}
    },
    {
      "source": "ticketto.dlx",
      "vhost": "/",
      "destination": "ticket-service.EventCancelled.dlq",
      "destination_type": "queue",
      "routing_key": "ticket-service.EventCancelled",
      "arguments": {}
    },
    {
      "source": "ticketto.dlx",
      "vhost": "/",
      "destination": "ticket-service.EventPublished.dlq",
      "destination_type": "queue",
      "routing_key": "ticket-service.EventPublished",
      "arguments": {}
    },
    {
      "source": "ticketto.dlx",
      "vhost": "/",
      "destination": "ticket-service.OrderConfirmed.dlq",
      "destination_type": "queue",
      "routing_key": "ticket-service.OrderConfirmed",
      "arguments": {}
    },
    {
      "source": "ticketto.dlx",
      "vhost": "/",
      "destination": "ticket-service.RefundCompleted.dlq",
      "destination_type": "queue",
      "routing_key": "ticket-service.RefundCompleted",
      "arguments": {}
    },
    {
      "source": "ticketto.unrouted",
      "vhost": "/",
      "destination": "ticketto.unrouted",
      "destination_type": "queue",
      "routing_key": "",
      "arguments": {}
    }
  ],
  "policies": [
    {
      "vhost": "/",
      "name": "events-ae",
      "pattern": "^[a-z]+(-[a-z]+)*\\.events$",
      "apply-to": "exchanges",
      "priority": 0,
      "definition": {
        "alternate-exchange": "ticketto.unrouted"
      }
    },
    {
      "vhost": "/",
      "name": "consumer-queues",
      "pattern": "^[a-z]+(-[a-z]+)*-service\\.[A-Za-z]+$",
      "apply-to": "queues",
      "priority": 0,
      "definition": {
        "delivery-limit": 5
      }
    },
    {
      "vhost": "/",
      "name": "holding-cap",
      "pattern": "\\.dlq$|^ticketto\\.unrouted$",
      "apply-to": "queues",
      "priority": 0,
      "definition": {
        "max-length": 50000,
        "overflow": "reject-publish",
        "delivery-limit": -1
      }
    }
  ]
}
