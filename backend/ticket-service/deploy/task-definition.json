{
  "family": "ticket-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "runtimePlatform": { "operatingSystemFamily": "LINUX", "cpuArchitecture": "X86_64" },
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "__ECS_EXECUTION_ROLE_ARN__",
  "containerDefinitions": [
    {
      "name": "ticket-service",
      "image": "__IMAGE__",
      "essential": true,
      "portMappings": [{ "containerPort": 3006, "protocol": "tcp" }],
      "environment": [
        { "name": "PORT", "value": "3006" },
        { "name": "DB_HOST", "value": "__RDS_ENDPOINT__" },
        { "name": "DB_PORT", "value": "3306" },
        { "name": "DB_NAME", "value": "db_ticket" },
        { "name": "DB_SSL_CA", "value": "/etc/ssl/rds/global-bundle.pem" },
        { "name": "AUTH_MODE", "value": "gateway" },
        { "name": "LOG_LEVEL", "value": "INFO" }
      ],
      "secrets": [
        { "name": "DB_USER", "valueFrom": "__DB_SECRET_ARN__:username::" },
        { "name": "DB_PASSWORD", "valueFrom": "__DB_SECRET_ARN__:password::" },
        { "name": "QR_SIGNING_KEYS", "valueFrom": "__QR_KEYS_SECRET_ARN__" }
      ],
      "healthCheck": {
        "command": [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://127.0.0.1:3006/health', timeout=2)"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ticket-service",
          "awslogs-region": "__AWS_REGION__",
          "awslogs-stream-prefix": "ticket-service"
        }
      }
    }
  ]
}
