# Copy to backend.hcl (gitignored), then:
#   tofu init -backend-config=backend.hcl
# The bucket is the team's shared state bucket.
bucket       = "rabibi-tfstate-<ACCOUNT_ID>"
key          = "notification-service/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true # S3-native lock: no DynamoDB table needed
