{
  "family": "notification-service-worker",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "X86_64"
  },
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "__ECS_EXECUTION_ROLE_ARN__",
  "taskRoleArn": "__ECS_TASK_ROLE_ARN__",
  "containerDefinitions": [
    {
      "name": "notification-service-worker",
      "image": "__IMAGE__",
      "essential": true,
      "stopTimeout": 60,
      "command": ["python", "-m", "app.worker"],
      "environment": [
        { "name": "AWS_REGION", "value": "__AWS_REGION__" },
        { "name": "DB_HOST", "value": "__RDS_ENDPOINT__" },
        { "name": "DB_PORT", "value": "3306" },
        { "name": "DB_NAME", "value": "db_notification" },
        { "name": "DB_SSL_CA", "value": "/etc/ssl/rds/global-bundle.pem" },
        { "name": "USER_SERVICE_URL", "value": "__USER_SERVICE_URL__" },
        { "name": "EVENT_SERVICE_URL", "value": "__EVENT_SERVICE_URL__" },
        { "name": "EMAIL_BACKEND", "value": "ses" },
        { "name": "EMAIL_FROM", "value": "__EMAIL_FROM__" },
        { "name": "SES_CONFIGURATION_SET", "value": "__SES_CONFIGURATION_SET__" },
        { "name": "LOG_LEVEL", "value": "INFO" }
      ],
      "secrets": [
        { "name": "DB_USER", "valueFrom": "__DB_SECRET_ARN__:username::" },
        { "name": "DB_PASSWORD", "valueFrom": "__DB_SECRET_ARN__:password::" },
        { "name": "RABBITMQ_URL", "valueFrom": "__RABBITMQ_SECRET_ARN__:url::" }
      ],
      "healthCheck": {
        "command": [
          "CMD",
          "python",
          "-c",
          "import os, sys, time; sys.exit(time.time() - os.path.getmtime('/tmp/notification-worker-heartbeat') > 180)"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/notification-service",
          "awslogs-region": "__AWS_REGION__",
          "awslogs-stream-prefix": "notification-service-worker"
        }
      }
    }
  ]
}
