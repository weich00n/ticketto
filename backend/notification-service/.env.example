# For running on your machine (python -m app.worker); Compose sets these itself.
DATABASE_URL=mysql+pymysql://notification_service:notification_local@127.0.0.1:3312/db_notification
RABBITMQ_URL=amqp://notification-service:ticketto-local@localhost:5672/%2F
USER_SERVICE_URL=http://localhost:18000
# Optional: titles for events published before this service started.
# EVENT_SERVICE_URL=http://localhost:3001
LOG_LEVEL=INFO

# ses (AWS: the SES API, with the worker's task role), smtp (Mailpit locally), or log.
EMAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1026
EMAIL_FROM=Ticketto <notifications@ticketto.local>
# EMAIL_MAX_ATTEMPTS=5
# EMAIL_RETRY_BASE_SECONDS=30
# Share of each run spent taking messages off the queues (the rest sends emails).
# DRAIN_BUDGET_FRACTION=0.5
# One run's time limit, then the wait after a normal run and after a failed one.
# WORKER_RUN_SECONDS=40
# WORKER_POLL_SECONDS=10
# WORKER_RETRY_SECONDS=60

# Used instead of DATABASE_URL in AWS. Never put real values here.
# DB_HOST=
# DB_PORT=3306
# DB_NAME=db_notification
# DB_USER=
# DB_PASSWORD=
# DB_SSL_CA=/etc/ssl/rds/global-bundle.pem
