# Copy to .env for local runs. Values match docker-compose.yml.
MYSQL_URL=mysql+asyncmy://queue:queue@localhost:3306/queue_service
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://queue:queue@localhost:5672/%2F

# Generate with: make keys
JWT_PRIVATE_KEY_PATH=secrets/jwt_private.pem
JWT_KID=queue-local-1
# Optional: directory of <kid>.pem public keys still published in JWKS during rotation.
JWT_PUBLIC_KEYS_DIR=

ADMITTER_TICK_SECONDS=1
# true (local): the consumer declares the whole RabbitMQ topology. false (shared broker):
# it only checks its own queues exist and subscribes to them.
RABBITMQ_DECLARE_TOPOLOGY=true
LOG_LEVEL=INFO
# json (default, production) or text (easier to read in a terminal)
LOG_FORMAT=text
