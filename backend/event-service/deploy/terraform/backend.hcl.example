# Copy to backend.hcl (gitignored) and put in the state bucket from deploy/README.md, then:
#   tofu init -backend-config=backend.hcl
bucket       = "rabibi-tfstate-<ACCOUNT_ID>"
key          = "event-service/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true # S3-native lock: no DynamoDB table needed
