# For running on your machine; Compose sets these itself.
DATABASE_URL=mysql+pymysql://ticketto:ticketto@localhost:3307/event_service
# This stack's own RabbitMQ (docker compose up). For the shared broker from rabbitmq-service use
# amqp://ticketto:ticketto-local@127.0.0.1:5672/%2F  (local-only password; gitleaks:allow)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F
PORT=3001
LOG_LEVEL=INFO

# Used instead of DATABASE_URL in AWS. Never put real values here.
# DB_HOST=
# DB_PORT=3306
# DB_NAME=db_event
# DB_USER=
# DB_PASSWORD=
# DB_SSL_CA=/etc/ssl/rds/global-bundle.pem
