# For running on your machine; Compose sets these itself.
DATABASE_URL=mysql+pymysql://ticketto:ticketto-local@localhost:3308/checkout_service
# Local broker is the shared ticketto-rabbitmq image (built from ../rabbitmq-service);
# its admin user is written by the broker's entrypoint. gitleaks:allow
RABBITMQ_URL=amqp://ticketto:ticketto-local@localhost:5673/%2F
RESERVATION_BASE_URL=http://localhost:8081
# Stripe test-mode keys. Fill in real values locally; never commit them.
# STRIPE_API_KEY is only needed for the live payment path (POST /orders creating a
# PaymentIntent); boot, the webhook and all tests work without it. When
# STRIPE_WEBHOOK_SECRET is left empty, the app and the tests fall back to the same
# throwaway local value (whsec_test_local).
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
PORT=3002
LOG_LEVEL=INFO
EXPIRY_SWEEP_SECONDS=10

# Used instead of DATABASE_URL in AWS. Never put real values here.
# DB_HOST=
# DB_PORT=3306
# DB_NAME=checkout_service
# DB_USER=
# DB_PASSWORD=
# DB_SSL_CA=/etc/ssl/rds/global-bundle.pem
