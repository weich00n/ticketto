# Local docker compose settings (copy to .env to change them). Never put real passwords here.
RABBITMQ_ADMIN_USER=ticketto
RABBITMQ_ADMIN_PASS=ticketto-local
# The password of every service user locally (user name = service name, e.g. event-service)
RABBITMQ_SERVICE_PASS_DEFAULT=ticketto-local
# Change these if another RabbitMQ is already using the ports.
RABBITMQ_AMQP_PORT=5672
RABBITMQ_UI_PORT=15672
